generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model EnvLog {
  id             Int      @id @default(autoincrement()) // 環境ログID
  deviceId       Int      @map("device_id") // デバイスとの関連  // TODO: FR devices(id)
  temperatureSht Float    @map("temperture_sht") // 温度（SHTセンサー由来）
  humidity       Float // 湿度
  temperatureQmp Float    @map("temperature_qmp") // 温度（QMPセンサー由来）
  pressure       Float // 気圧
  createdAt      DateTime @default(now()) @map("created_at") // レコード作成日時
  updatedAt      DateTime @updatedAt @map("updated_at") // レコード更新日時

  @@map("env_logs")
}
