// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

model EnvLog {
  id             Int      @id @default(autoincrement()) // 環境ログID
  // device Device @relation(fields: [deviceId], references: [id])
  deviceId       Int      @map("device_id") // デバイスとの関連  // TODO: FR devices(id)
  temperatureSht Float    @map("temperature_sht") // 温度（SHTセンサー由来）
  humidity       Float // 湿度
  temperatureQmp Float    @map("temperature_qmp") // 温度（QMPセンサー由来）
  pressure       Float // 気圧
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(3) // レコード作成日時
  updatedAt      DateTime @updatedAt @map("updated_at")  @db.Timestamp(3) // レコード更新日時

  @@map("env_logs")
}

model Device {
  id Int @id @default(autoincrement()) // デバイスの一意ID（主キー）
  macAddress String @unique @map("mac_address") // MACアドレス（ユニーク）
  ipAddress String @map("ip_address") // IPアドレス
  name String // デバイス名
  location String? @db.Text // 設置場所（省略可能）
  collectMetrics Boolean @map("collect_matrics") @default(false) // 環境情報を収集するかどうか
  registerdAt DateTime @map("registerd_at")  @db.Timestamp(3) // デバイスが登録された日時
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(3) // レコード作成日時
  updatedAt      DateTime @updatedAt @map("updated_at")  @db.Timestamp(3) // レコード更新日時

  irSensorValues IrSensorValue[] // 複数の操作値を持つ
  // envLog EnvLog[]

  @@map("devices")
}

model IrSensorValue { // TODO: IrSensorEntryに変更
  id Int @id @default(autoincrement()) // センサーデータID（主キー）
  device Device @relation(fields: [deviceId], references: [id])
  deviceId Int // デバイスとの関連
  name String // 信号名（例：TV電源など）
  // data String @db.Text // 赤外線信号データ
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(3) // レコード作成日時
  updatedAt      DateTime @updatedAt @map("updated_at")  @db.Timestamp(3) // レコード更新日時

  knownProtocolData IrSensorValueKnownProtocolData?
  rawData IrSensorValueRawData?

  @@map("ir_sensor_values")
}

model IrSensorValueKnownProtocolData {
  id Int @id @default(autoincrement())
  irSensorValueId Int @unique @map("ir_sensor_value_id")
  irSensorValue IrSensorValue @relation(fields: [irSensorValueId], references: [id])

  protocol String // プロトコルの種類。
  frequencyKHz Int @map("frequency_khz") // 赤外線搬送周波数（kHz）
  headerMarkMicros Int @map("header_mark_micros") // リーダーパルスON
  headerSpaceMicros Int @map("header_space_micros") // リーダパルスOFF
  oneMarkMicros Int @map("one_mark_micros") // 1のONパルス幅
  oneSpaceMicros Int @map("one_space_micros") // 1のOFFパルス幅
  zeroMarkMicros Int @map("zero_mark_micros") // 0のONパルス幅
  zeroSpaceMicros Int @map("zero_space_micros") // 0のOFFパルス幅
  data Json @map("data") // 送信データ（uint64_tのチャンク配列）
  numberOfBits Int @map("number_of_bits") // ビット数

  @@map("ir_sensor_value_known_protocol_data")
}

model IrSensorValueRawData {
  id Int @id @default(autoincrement())
  irSensorValueId Int @unique @map("ir_sensor_value_id")
  irSensorValue IrSensorValue @relation(fields: [irSensorValueId], references: [id])

  data Json  // 信号データ（ON, OFF時間の配列）
  frequencyKHz  Int @map("frequency_khz") // 赤外線搬送周波数（kHz）

  @@map("ir_sensor_value_raw_data")
}
